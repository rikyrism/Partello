# Partello configuration. Copy to .env for local use; never commit real secrets.

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# Leave empty to use the in-memory store (data lost on restart).
DATABASE_URL=postgres://partello:partello@localhost:5433/partello
# Comma-separated origins allowed for CORS and WebSocket Origin checks.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Used to build invite links returned by the API.
PUBLIC_BASE_URL=http://localhost:5173
# Directory with the built frontend (production: the server serves the SPA).
STATIC_DIR=
# Only behind a trusted reverse proxy: take client IPs from X-Forwarded-For.
TRUST_PROXY=false
# With TRUST_PROXY: read the client IP from this header instead (e.g. CF-Connecting-IP behind Cloudflare).
CLIENT_IP_HEADER=
# text | json
LOG_FORMAT=text
RUST_LOG=partello=info,tower_http=info

# --- Rooms ------------------------------------------------------------------
ROOM_MAX_PARTICIPANTS=16
# Empty: 8 for peer-to-peer calls, everyone in the room with an SFU.
ROOM_MAX_VOICE=
ROOM_MAX_QUEUE=100
RECONNECT_GRACE_SECS=45
IDLE_ROOM_TTL_SECS=600
ROOM_RETENTION_DAYS=30

# --- YouTube ----------------------------------------------------------------
# Title/thumbnail lookup + embeddability check via YouTube oEmbed (no key).
YOUTUBE_OEMBED=true
# Optional: YouTube Data API v3 key for in-room search, playlist import and
# the landing page's daily trending list. Server-side only.
YOUTUBE_API_KEY=
# Uncached searches per day for the whole server (each costs 100 of the 10,000 daily quota units).
YOUTUBE_SEARCH_DAILY_BUDGET=90
# Country whose YouTube chart fills "Pick a genre" (fetched once a day, about 8 units).
TRENDING_REGION=US
# When that daily fetch happens: this hour (0-23) at UTC+offset. Default 07:00 WIB.
TRENDING_REFRESH_HOUR=7
TRENDING_UTC_OFFSET=7

# --- WebRTC -----------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302
# TURN relays for restrictive networks, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
# coturn static-auth-secret; the server mints short-lived credentials from it.
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECS=21600
# Or fixed TURN credentials (e.g. a free Metered.ca account), used with TURN_URLS.
TURN_USERNAME=
TURN_CREDENTIAL=
# Or Cloudflare Realtime TURN (free tier): short-lived credentials are fetched
# on demand, no TURN_URLS needed. Create a TURN key in the Cloudflare dashboard.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Push notifications -----------------------------------------------------
# "Someone started watching" notifications need HTTPS (or localhost). The key
# pair is generated on first start and kept in the database; set these only to
# pin it (base64url P-256 private key) or to give push services a contact.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- SFU calls (optional) ---------------------------------------------------
# With all three set, calls go through LiveKit instead of the peer-to-peer mesh
# (self-hosted, or LiveKit Cloud's free tier).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Where this server reaches LiveKit's API; defaults to LIVEKIT_URL over https.
LIVEKIT_API_URL=

# --- Docker Compose ---------------------------------------------------------
# Host port for the local Postgres container (5432 is often taken).
POSTGRES_PORT=5433
