# Automatic HTTPS (Let's Encrypt) for the domain in DOMAIN; WebSockets are
# proxied transparently, so the app is served over https:// and wss://.
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# LiveKit signalling, when the optional SFU runs (profile "sfu").
	@livekit path /rtc /rtc/*
	reverse_proxy @livekit host.docker.internal:7880
	reverse_proxy app:8080
}
