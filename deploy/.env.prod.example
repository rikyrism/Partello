# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Your domain; its DNS A record must point at the VPS before starting.
DOMAIN=nonton.example.com
# The VPS public IPv4 address (used by the TURN server).
PUBLIC_IP=203.0.113.10

# Generate each with:  openssl rand -base64 32
POSTGRES_PASSWORD=
TURN_SHARED_SECRET=

# Optional: YouTube Data API v3 key for in-room search.
YOUTUBE_API_KEY=

ROOM_MAX_PARTICIPANTS=16
ROOM_MAX_VOICE=8
