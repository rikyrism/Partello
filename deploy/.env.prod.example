# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Your domain; its DNS A record must point at the VPS before starting.
DOMAIN=nonton.example.com
# The VPS public IPv4 address (used by the TURN server).
PUBLIC_IP=203.0.113.10

# Generate each with:  openssl rand -base64 32
POSTGRES_PASSWORD=
TURN_SHARED_SECRET=

# Optional: Cloudflare Realtime TURN instead of the bundled coturn (takes priority).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional: YouTube Data API v3 key for in-room search.
YOUTUBE_API_KEY=

ROOM_MAX_PARTICIPANTS=16
# Empty: 8 for peer-to-peer calls, everyone in the room with an SFU.
ROOM_MAX_VOICE=

# Optional SFU for bigger calls. Bundled LiveKit (start with --profile sfu):
#   LIVEKIT_URL=wss://<your DOMAIN>
#   LIVEKIT_API_URL=http://host.docker.internal:7880
#   LIVEKIT_API_KEY=<any name, e.g. partello>
#   LIVEKIT_API_SECRET=<openssl rand -base64 32>
# Or LiveKit Cloud: its wss:// URL, API key and secret (leave LIVEKIT_API_URL empty).
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
