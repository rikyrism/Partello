# Optional settings for ./scripts/tunnel.sh. Copy to .env.tunnel (never commit it).
# Everything here is optional; leave a line empty to skip that feature.

# --- Calls on mobile data: a free TURN relay ---------------------------------
# Without TURN, friends on mobile data (CGNAT) can watch and chat but often
# cannot hear or see each other. Pick ONE of these:
#
# a) Cloudflare Realtime TURN (recommended: short-lived credentials, generous
#    free tier). Cloudflare dashboard → Realtime → TURN → Create TURN key.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
#
# b) Metered.ca free plan: copy the TURN URLs, username and credential.
#    These are fixed and visible to everyone in a room.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Bigger calls: LiveKit Cloud (free tier) ----------------------------------
# With all three set, calls go through LiveKit instead of peer-to-peer, so more
# people can turn their cameras on. cloud.livekit.io → project → Settings → Keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- YouTube search and playlist import ---------------------------------------
# A YouTube Data API v3 key (Google Cloud console). Kept on the server only.
YOUTUBE_API_KEY=
